{
  "name": "backyourstack",
  "version": "1.2.0",
  "description": "BackYourStack analyzes repositories to recommend Open Source projects to support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/backyourstack/backyourstack.git"
  },
  "scripts": {
    "clean": "npm run build:clean && npm run test:clean",
    "deploy:production": "git push production main",
    "dev": "nodemon --exec babel-node --config-file ./babel.server.json -- src/index.js",
    "build": "npm run build:clean && npm run build:server && npm run build:next",
    "build:clean": "rm -rf dist .next",
    "build:server": "babel --config-file ./babel.server.json --copy-files ./src --out-dir ./dist",
    "build:next": "next build",
    "start": "NODE_ENV=production node dist/index.js",
    "start:next": "NODE_ENV=production next start",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "prettier": "prettier \"*.@(js|mjs|json|md)\" \"@(components|data|lib|pages|scripts|src|test)/**/*.@(js|json|md)\"",
    "prettier:write": "npm run prettier -- --write",
    "prettier:check": "npm run prettier -- --list-different",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:update": "npm test -- --updateSnapshot",
    "test:clean": "rm -rf coverage",
    "update-collectives": "babel-node --config-file ./babel.server.json ./scripts/update-collectives",
    "detect-packages": "./scripts/detect-all-packages.sh",
    "sync-projects-with-opencollective": "babel-node --config-file ./babel.server.json ./scripts/sync-projects-with-opencollective",
    "prepare": "husky"
  },
  "author": {
    "name": "Open Collective, Inc.",
    "email": "team@opencollective.com"
  },
  "contributors": [
    "François Hodierne <francois@opencollective.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@octokit/rest": "^22.0.1",
    "bluebird": "^3.7.2",
    "classnames": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fs-extra": "^11.4.1",
    "gemfile": "^1.1.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "md5": "^2.3.0",
    "minimatch": "^10.2.6",
    "multer": "^2.4.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "nprogress": "^0.2.0",
    "passport": "^0.7.0",
    "passport-github": "^1.1.0",
    "prop-types": "^15.8.1",
    "query-string": "^9.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-number-format": "^5.4.5",
    "serve-favicon": "^2.5.1",
    "styled-jsx": "^5.1.6",
    "toml": "^5.0.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "xmldoc": "^3.0.0"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "env.js"
    ],
    "ext": "js,json"
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/node": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@mdx-js/loader": "^3.1.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-opencollective": "^7.1.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
